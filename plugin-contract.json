{
  "schema_version": 1,
  "description": "Shared Wenlan plugin contract for the Claude Code and Codex plugin surfaces. It is the skill inventory and drift guard; the Codex skills themselves are generated from the Claude skills by scripts/gen-codex-plugin.mjs with plugin-codex/overlay.json.",
  "surfaces": {
    "claude": {
      "plugin_root": "plugin",
      "manifest_path": "plugin/.claude-plugin/plugin.json",
      "manifest_name": "wenlan",
      "manifest_display_name": "Wenlan",
      "mcp_config_path": "plugin/.mcp.json",
      "mcp_server_name": "wenlan",
      "mcp_command": "${CLAUDE_PLUGIN_ROOT}/scripts/wenlan-mcp-runner.sh",
      "skill_mcp_tool_prefix": "mcp__plugin_wenlan_wenlan__",
      "runner_path": "plugin/scripts/wenlan-mcp-runner.sh",
      "agent_name": {
        "mode": "wenlan_mcp_stdio_default",
        "value": "claude-code"
      },
      "marketplace": {
        "path": ".claude-plugin/marketplace.json",
        "name": "7xuanlu-wenlan",
        "plugin_name": "wenlan",
        "source": "git-subdir",
        "source_url": "https://github.com/wenlan-app/wenlan.git",
        "source_path": "plugin",
        "category": "productivity"
      }
    },
    "codex": {
      "plugin_root": "plugin-codex",
      "manifest_path": "plugin-codex/.codex-plugin/plugin.json",
      "manifest_name": "wenlan",
      "manifest_skills": "./skills/",
      "manifest_mcp_servers": "./.mcp.json",
      "mcp_config_path": "plugin-codex/.mcp.json",
      "mcp_server_name": "wenlan",
      "mcp_command": "./bin/wenlan-mcp-runner.sh",
      "mcp_cwd": ".",
      "skill_mcp_tool_prefix": "mcp__wenlan__",
      "runner_path": "plugin-codex/bin/wenlan-mcp-runner.sh",
      "agent_name": {
        "mode": "runner_argument_default",
        "env": "WENLAN_MCP_AGENT_NAME",
        "value": "codex"
      },
      "marketplace": {
        "path": ".agents/plugins/marketplace.json",
        "name": "7xuanlu-wenlan",
        "plugin_name": "wenlan",
        "source": "local",
        "source_path": "./plugin-codex",
        "policy_installation": "AVAILABLE",
        "policy_authentication": "ON_INSTALL",
        "category": "Productivity"
      }
    }
  },
